# ── Client (Vite — exposed to browser, prefix with VITE_) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_BASE_URL=http://localhost:3001

# ── Server (never exposed to the browser) ──
PORT=3001
NODE_ENV=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STORAGE_BUCKET=attachments
MAX_UPLOAD_BYTES=10485760

# ── Tests (tests/permissions.test.ts) ──
# A real auth.users id in the target Supabase project, used as the owner in
# the permissions integration test. The test skips itself if unset.
TEST_OWNER_USER_ID=
